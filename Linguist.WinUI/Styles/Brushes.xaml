<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 苹果液态磨砂玻璃渐变画刷 (Apple Liquid Glass) -->
    <LinearGradientBrush x:Key="AppleLiquidGlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E60F172A" Offset="0.0" /> <!-- 深邃蓝黑 slate-900 90% 不透明 -->
        <GradientStop Color="#F00B0F19" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 药丸胶囊高透液态玻璃画刷 -->
    <LinearGradientBrush x:Key="AppleLiquidPillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D80F172A" Offset="0.0" />
        <GradientStop Color="#E8090D16" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 玻璃边缘纳米级高光镜面边框 (高透细腻白) -->
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4DFFFFFF" Offset="0.0" /> <!-- 顶部 30% 白高反光 -->
        <GradientStop Color="#1AFFFFFF" Offset="0.5" />
        <GradientStop Color="#26FFFFFF" Offset="1.0" /> <!-- 底部 15% 白漫反射 -->
    </LinearGradientBrush>

    <!-- 激活与聚焦微光边框 -->
    <SolidColorBrush x:Key="ActiveGlassBorderBrush" Color="#663B82F6" />

    <!-- 次级组件内嵌背景 (搜索框/控件槽位) -->
    <SolidColorBrush x:Key="GlassSubtleInputBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="GlassSubtleInputHoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="GlassInputBorderBrush" Color="#2EFFFFFF" />

    <!-- 品牌重点色 -->
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentBlueLightBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="AccentBlueDarkBrush" Color="#1D4ED8" />

    <SolidColorBrush x:Key="AccentAmberBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="AccentEmeraldBrush" Color="#34D399" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="#F87171" />

    <!-- 文字排版颜色系统 (满足 WCAG AA 极佳可读性) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#475569" />

    <!-- 细微毛玻璃分割线 -->
    <SolidColorBrush x:Key="GlassDividerBrush" Color="#1AFFFFFF" />

    <!-- 标准圆角资源定义 -->
    <CornerRadius x:Key="CardOuterCornerRadius">32</CornerRadius>
    <CornerRadius x:Key="CardHeaderCornerRadius">32,32,0,0</CornerRadius>
    <CornerRadius x:Key="CardFooterCornerRadius">0,0,32,32</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">9999</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">9999</CornerRadius>
</ResourceDictionary>
