<Application
    x:Class="Linguist.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Linguist.WinUI.Converters"
    xmlns:local="using:Linguist.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Geometries.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 转换器字典 -->
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:BoolToFillConverter x:Key="BoolToFillConverter" />
            <converters:BoolToFavoriteColorConverter x:Key="BoolToFavoriteColorConverter" />
            <converters:BoolToFavoriteFillConverter x:Key="BoolToFavoriteFillConverter" />
            <converters:BoolToSwitchBackgroundConverter x:Key="BoolToSwitchBackgroundConverter" />
            <converters:BoolToSwitchAlignConverter x:Key="BoolToSwitchAlignConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

            <!-- 无边框无衬底纯净按钮样式 -->
            <Style x:Key="GlassIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="CornerRadius" Value="9999" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
