<UserControl
    x:Class="Linguist.WinUI.Views.CardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Linguist.WinUI.Models"
    xmlns:viewmodels="using:Linguist.WinUI.ViewModels"
    mc:Ignorable="d"
    AutomationProperties.Name="Linguist 悬浮翻译卡片"
    AutomationProperties.AutomationId="LinguistCardContainer">

    <!-- 主外框：严谨设定 32px 大圆角与 Apple 镜面玻璃高光边框 -->
    <Border
        x:Name="CardOuterBorder"
        Width="390"
        Height="520"
        CornerRadius="{StaticResource CardOuterCornerRadius}"
        Background="{StaticResource AppleLiquidGlassBrush}"
        BorderBrush="{StaticResource GlassBorderBrush}"
        BorderThickness="1"
        AutomationProperties.Name="卡片主外框">

        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- =========================================================================
                 1. 顶部操作栏 (Header Bar, 32px 顶部圆角，支持原生平滑拖拽)
                 ========================================================================= -->
            <Border
                Grid.Row="0"
                Height="46"
                CornerRadius="{StaticResource CardHeaderCornerRadius}"
                Background="#10FFFFFF"
                BorderBrush="{StaticResource GlassDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,0,14,0"
                PointerPressed="OnHeaderPointerPressed"
                AutomationProperties.Name="卡片顶部标题栏">

                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    
                    <!-- 左侧：经典三色交通灯控制点 (Traffic Lights) -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="7"
                        VerticalAlignment="Center">
                        <!-- 红色：清空内容 / 最小化托盘 -->
                        <Button
                            Width="12"
                            Height="12"
                            Padding="0"
                            CornerRadius="6"
                            Background="#E6F87171"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.ClearTextCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="清空内容"
                            AutomationProperties.Name="清空内容"
                            AutomationProperties.AutomationId="TrafficRedBtn" />
                        <!-- 黄色：收缩为药丸胶囊 -->
                        <Button
                            Width="12"
                            Height="12"
                            Padding="0"
                            CornerRadius="6"
                            Background="#E6FBBF24"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.SwitchToPillCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="收起为药丸胶囊"
                            AutomationProperties.Name="收起为药丸胶囊"
                            AutomationProperties.AutomationId="TrafficYellowBtn" />
                        <!-- 绿色：刷新翻译 -->
                        <Button
                            Width="12"
                            Height="12"
                            Padding="0"
                            CornerRadius="6"
                            Background="#E634D399"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.RefreshTranslationCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="刷新翻译"
                            AutomationProperties.Name="刷新翻译"
                            AutomationProperties.AutomationId="TrafficGreenBtn" />
                    </StackPanel>

                    <!-- 中间：语言切换药丸 + 引擎指示胶囊 -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <!-- 语言选择药丸 -->
                        <Border
                            Height="26"
                            CornerRadius="13"
                            Background="{StaticResource GlassSubtleInputBrush}"
                            BorderBrush="{StaticResource GlassInputBorderBrush}"
                            BorderThickness="1"
                            Padding="8,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SourceLang, Mode=OneWay}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}" />
                                <!-- 语言交换按钮 -->
                                <Button
                                    Style="{StaticResource GlassIconButtonStyle}"
                                    Width="18"
                                    Height="18"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.SwapLanguagesCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="交换源语言与目标语言"
                                    AutomationProperties.Name="交换语言">
                                    <Path
                                        Data="{StaticResource SwapIconGeometry}"
                                        Stroke="{StaticResource AccentBlueLightBrush}"
                                        StrokeThickness="1.2"
                                        Width="10"
                                        Height="10" />
                                </Button>
                                <TextBlock
                                    Text="{x:Bind ViewModel.TargetLang, Mode=OneWay}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 翻译引擎胶囊 (如 Gemini / DeepL) -->
                        <Border
                            Height="26"
                            CornerRadius="13"
                            Background="{StaticResource GlassSubtleInputBrush}"
                            BorderBrush="{StaticResource GlassInputBorderBrush}"
                            BorderThickness="1"
                            Padding="8,0,8,0"
                            ToolTipService.ToolTip="当前 AI 翻译引擎: Gemini">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentEmeraldBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.EngineName, Mode=OneWay}"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource AccentBlueLightBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 右侧：截图、置顶、字号与设置工具按钮群 -->
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="3"
                        VerticalAlignment="Center">
                        <!-- 截图翻译 -->
                        <Button
                            Style="{StaticResource GlassIconButtonStyle}"
                            Width="28"
                            Height="28"
                            ToolTipService.ToolTip="截图框选翻译"
                            AutomationProperties.Name="截图框选翻译">
                            <Path
                                Data="{StaticResource CropIconGeometry}"
                                Stroke="{StaticResource AccentBlueLightBrush}"
                                StrokeThickness="1.5"
                                Width="13"
                                Height="13" />
                        </Button>

                        <!-- 置顶固定按钮 -->
                        <Button
                            Style="{StaticResource GlassIconButtonStyle}"
                            Width="28"
                            Height="28"
                            Command="{x:Bind ViewModel.TogglePinCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="置顶窗口"
                            AutomationProperties.Name="置顶固定窗口"
                            AutomationProperties.AutomationId="CardPinBtn">
                            <Path
                                Data="{StaticResource PinIconGeometry}"
                                Stroke="{x:Bind ViewModel.IsPinned, Mode=OneWay, Converter={StaticResource BoolToColorConverter}}"
                                Fill="{x:Bind ViewModel.IsPinned, Mode=OneWay, Converter={StaticResource BoolToFillConverter}}"
                                StrokeThickness="1.5"
                                Width="13"
                                Height="13" />
                        </Button>

                        <!-- 字体大小指示胶囊 -->
                        <Border
                            Height="24"
                            CornerRadius="12"
                            Background="{StaticResource GlassSubtleInputBrush}"
                            BorderBrush="{StaticResource GlassInputBorderBrush}"
                            BorderThickness="1"
                            Padding="6,0,6,0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="调节字体排版比例">
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Path
                                    Data="{StaticResource TypeIconGeometry}"
                                    Stroke="{StaticResource TextTertiaryBrush}"
                                    StrokeThickness="1.2"
                                    Width="11"
                                    Height="11" />
                                <TextBlock
                                    Text="92%"
                                    FontSize="10"
                                    FontFamily="Consolas"
                                    Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 偏好设置按钮 -->
                        <Button
                            Style="{StaticResource GlassIconButtonStyle}"
                            Width="28"
                            Height="28"
                            ToolTipService.ToolTip="偏好设置"
                            AutomationProperties.Name="偏好设置">
                            <Path
                                Data="{StaticResource SlidersIconGeometry}"
                                Stroke="{StaticResource TextSecondaryBrush}"
                                StrokeThickness="1.5"
                                Width="13"
                                Height="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =========================================================================
                 2. 主内容区域 (输入框 + 词典详细释义 + 例句 + 快捷操作栏)
                 ========================================================================= -->
            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="16,14,16,14">
                
                <StackPanel Spacing="14">
                    <!-- 搜索输入框 (大圆角磨砂输入区域) -->
                    <Border
                        CornerRadius="16"
                        Background="{StaticResource GlassSubtleInputBrush}"
                        BorderBrush="{StaticResource GlassInputBorderBrush}"
                        BorderThickness="1"
                        Padding="10,8,10,8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Path
                                Grid.Column="0"
                                Data="{StaticResource SearchIconGeometry}"
                                Stroke="{StaticResource AccentBlueLightBrush}"
                                StrokeThickness="1.5"
                                Width="15"
                                Height="15"
                                VerticalAlignment="Top"
                                Margin="0,3,8,0" />
                            
                            <TextBox
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.SourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="输入单词句子或划词翻译..."
                                FontSize="13"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MaxHeight="72"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                AutomationProperties.Name="主翻译文本输入框"
                                AutomationProperties.AutomationId="MainSearchInput" />

                            <Button
                                Grid.Column="2"
                                Style="{StaticResource GlassIconButtonStyle}"
                                Width="24"
                                Height="24"
                                Command="{x:Bind ViewModel.ClearTextCommand, Mode=OneWay}"
                                ToolTipService.ToolTip="清空输入"
                                AutomationProperties.Name="清空输入">
                                <Path
                                    Data="{StaticResource CloseIconGeometry}"
                                    Stroke="{StaticResource TextTertiaryBrush}"
                                    StrokeThickness="1.5"
                                    Width="11"
                                    Height="11" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 丰富词典释义卡片 (Word Details) -->
                    <StackPanel Spacing="12">
                        <!-- 单词标题 + 音标 + 发音 + 收藏 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.CurrentResult.SourceText, Mode=OneWay}"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.CurrentResult.PhoneticUs, Mode=OneWay}"
                                    FontSize="12"
                                    FontFamily="Consolas"
                                    Foreground="{StaticResource AccentBlueLightBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button
                                    Style="{StaticResource GlassIconButtonStyle}"
                                    Width="28"
                                    Height="28"
                                    ToolTipService.ToolTip="朗读发音"
                                    AutomationProperties.Name="朗读发音">
                                    <Path
                                        Data="{StaticResource VolumeIconGeometry}"
                                        Stroke="{StaticResource TextSecondaryBrush}"
                                        StrokeThickness="1.5"
                                        Width="13"
                                        Height="13" />
                                </Button>
                                <Button
                                    Style="{StaticResource GlassIconButtonStyle}"
                                    Width="28"
                                    Height="28"
                                    Command="{x:Bind ViewModel.ToggleFavoriteCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="加入生词本"
                                    AutomationProperties.Name="收藏生词">
                                    <Path
                                        Data="{StaticResource HeartIconGeometry}"
                                        Stroke="{x:Bind ViewModel.IsFavorite, Mode=OneWay, Converter={StaticResource BoolToFavoriteColorConverter}}"
                                        Fill="{x:Bind ViewModel.IsFavorite, Mode=OneWay, Converter={StaticResource BoolToFavoriteFillConverter}}"
                                        StrokeThickness="1.5"
                                        Width="13"
                                        Height="13" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 词性与释义列表 (带蓝色词性药丸胶囊) -->
                        <StackPanel Spacing="8">
                            <!-- 释义 1 -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                <Border
                                    CornerRadius="6"
                                    Background="#2E3B82F6"
                                    BorderBrush="#4D3B82F6"
                                    BorderThickness="1"
                                    Padding="5,1,5,1">
                                    <TextBlock
                                        Text="adj."
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        FontStyle="Italic"
                                        Foreground="{StaticResource AccentBlueLightBrush}" />
                                </Border>
                                <TextBlock
                                    Text="产生预期效果的，效率高的，有能力的"
                                    FontSize="13"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 释义 2 -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                <Border
                                    CornerRadius="6"
                                    Background="#2E3B82F6"
                                    BorderBrush="#4D3B82F6"
                                    BorderThickness="1"
                                    Padding="5,1,5,1">
                                    <TextBlock
                                        Text="adj."
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        FontStyle="Italic"
                                        Foreground="{StaticResource AccentBlueLightBrush}" />
                                </Border>
                                <TextBlock
                                    Text="(机器、系统等) 节能的，高效运转的"
                                    FontSize="13"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 同义词标签气泡流 (Synonyms Chips) -->
                        <StackPanel Spacing="5" Margin="0,2,0,0">
                            <TextBlock
                                Text="同义词"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextTertiaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border
                                    CornerRadius="10"
                                    Background="#1AFFFFFF"
                                    BorderBrush="#26FFFFFF"
                                    BorderThickness="1"
                                    Padding="7,3,7,3">
                                    <TextBlock Text="effective" FontSize="11" Foreground="{StaticResource AccentBlueLightBrush}" />
                                </Border>
                                <Border
                                    CornerRadius="10"
                                    Background="#1AFFFFFF"
                                    BorderBrush="#26FFFFFF"
                                    BorderThickness="1"
                                    Padding="7,3,7,3">
                                    <TextBlock Text="productive" FontSize="11" Foreground="{StaticResource AccentBlueLightBrush}" />
                                </Border>
                                <Border
                                    CornerRadius="10"
                                    Background="#1AFFFFFF"
                                    BorderBrush="#26FFFFFF"
                                    BorderThickness="1"
                                    Padding="7,3,7,3">
                                    <TextBlock Text="streamlined" FontSize="11" Foreground="{StaticResource AccentBlueLightBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- 双语对照例句 (Examples) -->
                        <Border
                            CornerRadius="12"
                            Background="#0FFFFFFF"
                            BorderBrush="{StaticResource GlassDividerBrush}"
                            BorderThickness="1"
                            Padding="10,8,10,8"
                            Margin="0,4,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Text="例句与用法"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextTertiaryBrush}" />
                                <TextBlock
                                    Text="• The new algorithm is highly efficient. / 新算法非常高效。"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="• An efficient use of time and resources. / 对时间和资源的有效利用。"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 快捷操作栏：语言对标示、一键复制、发音、收藏、生词历史 -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0" Padding="0,6,0,0">
                            <TextBlock
                                Grid.Column="0"
                                Text="en ➔ zh"
                                FontSize="11"
                                FontFamily="Consolas"
                                Foreground="{StaticResource AccentBlueLightBrush}"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button
                                    Style="{StaticResource GlassIconButtonStyle}"
                                    Width="28"
                                    Height="28"
                                    Command="{x:Bind ViewModel.CopyTranslationCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="复制完整释义"
                                    AutomationProperties.Name="复制完整释义">
                                    <Path
                                        Data="{StaticResource CopyIconGeometry}"
                                        Stroke="{StaticResource TextSecondaryBrush}"
                                        StrokeThickness="1.5"
                                        Width="13"
                                        Height="13" />
                                </Button>
                                <Button
                                    Style="{StaticResource GlassIconButtonStyle}"
                                    Width="28"
                                    Height="28"
                                    ToolTipService.ToolTip="历史记录与生词本"
                                    AutomationProperties.Name="历史与生词本">
                                    <Path
                                        Data="{StaticResource HistoryIconGeometry}"
                                        Stroke="{StaticResource TextSecondaryBrush}"
                                        StrokeThickness="1.5"
                                        Width="13"
                                        Height="13" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- =========================================================================
                 3. 底部状态栏 (Footer Bar, 32px 底部圆角，智能划词状态与尺寸标识)
                 ========================================================================= -->
            <Border
                Grid.Row="2"
                Height="40"
                CornerRadius="{StaticResource CardFooterCornerRadius}"
                Background="#10FFFFFF"
                BorderBrush="{StaticResource GlassDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0,16,0"
                AutomationProperties.Name="卡片底部状态栏">

                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <!-- 左侧：Smart-Select 智能划词开关指示 -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <!-- 迷你滑动胶囊开关 -->
                        <Border
                            Width="28"
                            Height="15"
                            CornerRadius="7.5"
                            Background="{x:Bind ViewModel.SelectionTranslationEnabled, Mode=OneWay, Converter={StaticResource BoolToSwitchBackgroundConverter}}"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            PointerPressed="OnSmartSelectTogglePressed"
                            ToolTipService.ToolTip="点击切换划词翻译开启/暂停状态"
                            AutomationProperties.Name="智能划词开关">
                            <Ellipse
                                Width="11"
                                Height="11"
                                Fill="#FFFFFF"
                                HorizontalAlignment="{x:Bind ViewModel.SelectionTranslationEnabled, Mode=OneWay, Converter={StaticResource BoolToSwitchAlignConverter}}"
                                Margin="1,0,1,0" />
                        </Border>
                        <TextBlock
                            Text="SMART-SELECT"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 右侧：尺寸标识与拉伸提示 -->
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="四角可缩放"
                            FontSize="10"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="390×520"
                            FontSize="10"
                            FontFamily="Consolas"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
