<UserControl
    x:Class="Linguist.WinUI.Views.PillView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Linguist.WinUI.ViewModels"
    mc:Ignorable="d"
    AutomationProperties.Name="Linguist 悬浮药丸翻译胶囊"
    AutomationProperties.AutomationId="LinguistPillContainer">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- 药丸主容器：32px/9999px 全圆角，高透液态玻璃渐变与镜面高光边框 -->
        <Border
            x:Name="PillBorder"
            Height="46"
            MinWidth="320"
            MaxWidth="460"
            CornerRadius="9999"
            Background="{StaticResource AppleLiquidPillBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1"
            Padding="6,4,8,4"
            PointerPressed="OnPillPointerPressed"
            AutomationProperties.Name="药丸主背景">

            <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
                
                <!-- 最左侧圆角区域：快捷红绿微控小圆点 (清空与展开) -->
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Center"
                    Margin="4,0,8,0">
                    <!-- 红色清空小圆点 -->
                    <Button
                        Width="10"
                        Height="10"
                        Padding="0"
                        CornerRadius="5"
                        Background="#CCF87171"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.ClearTextCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="清空内容"
                        AutomationProperties.Name="清空输入内容"
                        AutomationProperties.AutomationId="PillClearDotBtn" />
                    <!-- 绿色展开小圆点 -->
                    <Button
                        Width="10"
                        Height="10"
                        Padding="0"
                        CornerRadius="5"
                        Background="#CC34D399"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.SwitchToCardCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="展开为完整卡片"
                        AutomationProperties.Name="展开为完整卡片"
                        AutomationProperties.AutomationId="PillExpandDotBtn" />
                </StackPanel>

                <!-- 动态自适应搜索框 -->
                <Border
                    Grid.Column="1"
                    Height="30"
                    MinWidth="110"
                    CornerRadius="15"
                    Background="{StaticResource GlassSubtleInputBrush}"
                    BorderBrush="{StaticResource GlassInputBorderBrush}"
                    BorderThickness="1"
                    Padding="6,2,6,2"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path
                            Grid.Column="0"
                            Data="{StaticResource SearchIconGeometry}"
                            Stroke="{StaticResource AccentBlueLightBrush}"
                            StrokeThickness="1.5"
                            Width="13"
                            Height="13"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0" />
                        <TextBox
                            Grid.Column="1"
                            Text="{x:Bind ViewModel.SourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="搜索/翻译..."
                            FontSize="12"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="药丸快捷搜索翻译输入框"
                            AutomationProperties.AutomationId="PillSearchTextBox" />
                    </Grid>
                </Border>

                <!-- 原文与译文展示区 (支持自适应双语对齐与跑马灯显示) -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- 原文 -->
                        <TextBlock
                            Text="{x:Bind ViewModel.SourceText, Mode=OneWay}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="90"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="当前原文" />

                        <!-- 分隔箭头 -->
                        <TextBlock
                            Text="➔"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{StaticResource AccentBlueBrush}"
                            VerticalAlignment="Center" />

                        <!-- 译文 -->
                        <TextBlock
                            Text="{x:Bind ViewModel.CurrentResult.TranslatedText, Mode=OneWay}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="130"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="当前翻译结果" />
                    </StackPanel>
                </Grid>

                <!-- 最右侧快捷操作工具按钮群 -->
                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">
                    <!-- 朗读发音按钮 -->
                    <Button
                        Style="{StaticResource GlassIconButtonStyle}"
                        Width="28"
                        Height="28"
                        ToolTipService.ToolTip="朗读发音"
                        AutomationProperties.Name="朗读发音"
                        AutomationProperties.AutomationId="PillSpeakBtn">
                        <Path
                            Data="{StaticResource VolumeIconGeometry}"
                            Stroke="{StaticResource TextSecondaryBrush}"
                            StrokeThickness="1.5"
                            Width="13"
                            Height="13" />
                    </Button>

                    <!-- 一键复制按钮 -->
                    <Button
                        Style="{StaticResource GlassIconButtonStyle}"
                        Width="28"
                        Height="28"
                        Command="{x:Bind ViewModel.CopyTranslationCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="复制完整释义"
                        AutomationProperties.Name="复制完整释义"
                        AutomationProperties.AutomationId="PillCopyBtn">
                        <Path
                            Data="{StaticResource CopyIconGeometry}"
                            Stroke="{StaticResource TextSecondaryBrush}"
                            StrokeThickness="1.5"
                            Width="13"
                            Height="13" />
                    </Button>

                    <!-- 展开为完整卡片按钮 (大圆图标) -->
                    <Button
                        Width="28"
                        Height="28"
                        Padding="0"
                        CornerRadius="14"
                        Background="#26FFFFFF"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        Command="{x:Bind ViewModel.SwitchToCardCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="展开为完整卡片"
                        AutomationProperties.Name="展开为完整卡片"
                        AutomationProperties.AutomationId="PillExpandCardBtn">
                        <Path
                            Data="{StaticResource MaximizeIconGeometry}"
                            Stroke="{StaticResource TextPrimaryBrush}"
                            StrokeThickness="1.5"
                            Width="12"
                            Height="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
